{
  "$schema": "./orca.config.schema.json",
  "version": "0.4.0",
  "budgets": {
    "maxParallelAgents": 4,
    "maxParallelWorktrees": 6,
    "perRole": {
      "orca-orchestrator": {
        "maxTurns": 60
      },
      "grok-build": {
        "maxTurns": 25
      },
      "claude-code": {
        "maxTurns": 40
      },
      "codex": {
        "maxTurns": 40
      },
      "orca-reviewer": {
        "maxTurns": 25
      }
    },
    "softTokenHintPerAgent": 80000,
    "hardStopOnRepeatedFailures": 3,
    "stopConditions": [
      "acceptance_criteria_met",
      "review_gate_passed",
      "budget_exhausted",
      "user_abort",
      "plan_rejected"
    ]
  },
  "planValidation": {
    "required": true,
    "checkpointBeforeFanOut": true,
    "allowReplan": true,
    "minAcceptanceChecks": 1,
    "planFile": ".orca/plan.json"
  },
  "reviewGate": {
    "requiredBeforeMerge": true,
    "requireReviewerApproval": true,
    "checks": [
      "lint",
      "typecheck",
      "test"
    ],
    "rerunAfterConflictResolution": true,
    "reReviewWhenPatchChanges": true,
    "stepTimeoutSec": 1800
  },
  "merge": {
    "rebaseOnBaseBeforeMerge": true,
    "baseCandidates": [
      "origin/dev",
      "origin/main",
      "dev",
      "main",
      "master"
    ],
    "dryRunDefault": true,
    "conflictOwner": "codex",
    "neverForcePush": true,
    "pushBase": false,
    "draftPr": true,
    "deleteBranchRequiresFlag": true
  },
  "isolation": {
    "uniqueDevPort": true,
    "portBase": 3100,
    "portRange": 800,
    "envWorktreeFile": ".env.worktree",
    "dbBranchPerWorktree": true,
    "dbBranchPrefix": "wt-",
    "migrationOrdering": "base-first-then-feature",
    "forbidSharedWritableDb": true
  },
  "mcpRouting": {
    "perplexity": {
      "roles": [
        "orca-orchestrator",
        "grok-build"
      ],
      "useFor": [
        "planning",
        "research",
        "external_facts"
      ],
      "optional": true,
      "auth": "oauth",
      "fallback": [
        "WebSearch",
        "WebFetch"
      ]
    },
    "context7": {
      "roles": [
        "claude-code",
        "codex",
        "orca-reviewer"
      ],
      "useFor": [
        "library_docs",
        "api_reference",
        "implementation"
      ],
      "optional": true,
      "auth": "none",
      "fallback": [
        "WebFetch"
      ]
    }
  },
  "queue": {
    "order": [
      "dependsOn",
      "ready",
      "baseConflicts",
      "pairConflicts",
      "overlaps",
      "diffLines"
    ],
    "predictConflicts": true
  },
  "ledger": {
    "enabled": true,
    "file": "runs.jsonl",
    "recordAgentRuns": true
  }
}
