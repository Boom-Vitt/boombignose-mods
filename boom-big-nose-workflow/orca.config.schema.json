{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Boom-Vitt/claude-mods-boombignose/boom-big-nose-workflow/orca.config.schema.json",
  "title": "Orca config (Boom Big Nose Workflow)",
  "type": "object",
  "required": [
    "version",
    "budgets",
    "planValidation",
    "reviewGate",
    "merge",
    "isolation",
    "mcpRouting",
    "queue",
    "ledger"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "budgets": {
      "type": "object",
      "required": [
        "maxParallelAgents",
        "maxParallelWorktrees",
        "perRole",
        "stopConditions"
      ],
      "properties": {
        "maxParallelAgents": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxParallelWorktrees": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "perRole": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "maxTurns"
            ],
            "properties": {
              "maxTurns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              }
            }
          }
        },
        "softTokenHintPerAgent": {
          "type": "integer",
          "minimum": 1000
        },
        "hardStopOnRepeatedFailures": {
          "type": "integer",
          "minimum": 1
        },
        "stopConditions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "planValidation": {
      "type": "object",
      "required": [
        "required",
        "checkpointBeforeFanOut",
        "allowReplan"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "checkpointBeforeFanOut": {
          "type": "boolean"
        },
        "allowReplan": {
          "type": "boolean"
        },
        "minAcceptanceChecks": {
          "type": "integer",
          "minimum": 0
        },
        "planFile": {
          "type": "string"
        }
      }
    },
    "reviewGate": {
      "type": "object",
      "required": [
        "requiredBeforeMerge",
        "requireReviewerApproval",
        "checks"
      ],
      "properties": {
        "requiredBeforeMerge": {
          "type": "boolean"
        },
        "requireReviewerApproval": {
          "type": "boolean"
        },
        "checks": {
          "type": "array",
          "items": {
            "enum": [
              "lint",
              "typecheck",
              "test"
            ]
          },
          "minItems": 1
        },
        "rerunAfterConflictResolution": {
          "type": "boolean"
        },
        "reReviewWhenPatchChanges": {
          "type": "boolean"
        },
        "stepTimeoutSec": {
          "type": "integer",
          "minimum": 10,
          "maximum": 86400
        }
      }
    },
    "merge": {
      "type": "object",
      "required": [
        "baseCandidates",
        "dryRunDefault",
        "neverForcePush"
      ],
      "properties": {
        "rebaseOnBaseBeforeMerge": {
          "type": "boolean"
        },
        "baseCandidates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "dryRunDefault": {
          "const": true
        },
        "conflictOwner": {
          "type": "string"
        },
        "neverForcePush": {
          "const": true
        },
        "pushBase": {
          "const": false
        },
        "draftPr": {
          "type": "boolean"
        },
        "deleteBranchRequiresFlag": {
          "const": true
        }
      }
    },
    "isolation": {
      "type": "object",
      "required": [
        "portBase",
        "portRange",
        "envWorktreeFile"
      ],
      "properties": {
        "uniqueDevPort": {
          "type": "boolean"
        },
        "portBase": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 64000
        },
        "portRange": {
          "type": "integer",
          "minimum": 10,
          "maximum": 1000
        },
        "envWorktreeFile": {
          "type": "string"
        },
        "dbBranchPerWorktree": {
          "type": "boolean"
        },
        "dbBranchPrefix": {
          "type": "string"
        },
        "migrationOrdering": {
          "type": "string"
        },
        "forbidSharedWritableDb": {
          "type": "boolean"
        }
      }
    },
    "mcpRouting": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "roles",
          "useFor",
          "optional",
          "fallback"
        ],
        "properties": {
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "useFor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "optional": {
            "type": "boolean"
          },
          "auth": {
            "enum": [
              "oauth",
              "apiKey",
              "none"
            ]
          },
          "fallback": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "required": [
        "order"
      ],
      "properties": {
        "order": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "dependsOn",
              "ready",
              "baseConflicts",
              "pairConflicts",
              "overlaps",
              "diffLines"
            ]
          }
        },
        "predictConflicts": {
          "type": "boolean"
        }
      }
    },
    "ledger": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "recordAgentRuns": {
          "type": "boolean"
        }
      }
    }
  }
}
